{
  "name": "@smcp/core",
  "version": "0.1.2",
  "description": "Headless core SDK for AI Agent Skills and MCP server configurations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "mcp",
    "agent-skills",
    "model-context-protocol",
    "sdk"
  ],
  "author": "ghug",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
