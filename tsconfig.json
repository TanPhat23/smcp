{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false,
    "strict": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "types": ["@types/bun", "@types/node"],
    "paths": {
      "@tanphat/smcp-core": ["./packages/core/src/index.ts"],
      "@tanphat/smcp-core/*": ["./packages/core/src/*"],
      "smcp": ["./packages/cli/src/index.ts"],
      "smcp/core": ["./packages/cli/src/core.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "tests/**/*"]
}
