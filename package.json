{
  "name": "smcp-monorepo",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanPhat23/smcp.git"
  },
  "license": "MIT",
  "author": "TanPhat23",
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:core": "cd packages/core && bun run build",
    "build:cli": "cd packages/cli && bun run build",
    "build": "bun run build:core && bun run build:cli",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@clack/prompts": "^0.10.0",
    "@types/bun": "latest",
    "@types/node": "^22.13.0",
    "@types/write-file-atomic": "^4.0.3",
    "axios": "^1.20.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.3",
    "write-file-atomic": "^8.0.0"
  }
}
